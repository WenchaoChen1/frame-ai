# ===========================================
# 数据库配置
# ===========================================
# PostgreSQL 数据库连接字符串
# 格式: postgresql://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatai

# ===========================================
# JWT 认证配置
# ===========================================
# JWT 密钥（生产环境必须修改为强密钥）
# 生成方法: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here
# 加密算法
ALGORITHM=HS256
# Token 过期时间（分钟）10080 = 7天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===========================================
# 数据库加密配置
# ===========================================
# 用于加密数据库配置中的敏感信息（如密码）
# 生成方法: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DB_ENCRYPTION_KEY=your-encryption-key-here

# ===========================================
# AI 服务提供商配置
# ===========================================
# OpenAI API 密钥（用于 GPT 模型和嵌入）
# 获取地址: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
# Anthropic API 密钥（用于 Claude 模型）
# 获取地址: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key
# Ollama 本地服务地址（用于本地 LLM）
OLLAMA_BASE_URL=http://localhost:11434

# ===========================================
# CORS 跨域配置
# ===========================================
# 允许的跨域源，开发环境使用 "*"，生产环境应指定具体域名
# 多个域名用逗号分隔，例如: http://localhost:3000,https://example.com
CORS_ORIGINS=*

# ===========================================
# 向量存储配置
# ===========================================
# Elasticsearch 服务地址
ELASTICSEARCH_URL=http://localhost:9200
# Elasticsearch API 密钥（可选，如果 ES 开启了安全认证）
ELASTICSEARCH_API_KEY=
# Elasticsearch 索引前缀
ELASTICSEARCH_INDEX_PREFIX=kb_
# 是否启用 PostgreSQL 向量扩展 (pgvector)
PGVECTOR_ENABLED=True

# ===========================================
# 嵌入模型配置
# ===========================================
# 默认嵌入模型: openai 或 huggingface
DEFAULT_EMBEDDING_MODEL=openai
# OpenAI 嵌入模型名称
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# HuggingFace 嵌入模型名称（用于本地部署）
HUGGINGFACE_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ===========================================
# 文档处理配置
# ===========================================
# 最大文件大小（字节）52428800 = 50MB
MAX_FILE_SIZE=52428800
# 文本分块大小（字符数）
CHUNK_SIZE=500
# 文本分块重叠大小（字符数）
CHUNK_OVERLAP=50

# ===========================================
# RAG（检索增强生成）配置
# ===========================================
# 检索时返回的文档数量
TOP_K_RETRIEVAL=10
# 重排序后保留的文档数量
TOP_K_RERANK=5
# 是否启用查询重写
ENABLE_QUERY_REWRITE=True
# 是否启用重排序
ENABLE_RERANKING=True